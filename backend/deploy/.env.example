# 复制成 .env 后填写。所有值都用单引号或裸值，不要加引号里的多余空格。
#
# 生成两个密钥：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_DB=dszoon
POSTGRES_USER=dszoon
POSTGRES_PASSWORD=改成一个强口令

# ★ 设备凭据加密密钥。换掉它 = 所有设备密码要重录，且丢了无法恢复
DSZOON_SECRET_KEY=
DSZOON_JWT_SECRET=

# 初始管理员口令（留空则启动日志里打印一次随机口令，只在首次建库时生效）
DSZOON_ADMIN_PASSWORD=

# 全局并发与端口
DSZOON_BACKUP_CONCURRENCY=20
APP_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Shanghai

# ---- P2 ----
# 时区很重要：cron 的"每天 02:00"是按容器本地时间算的，TZ 写错会变成半夜跑
# （compose 里已经把 TZ 透传进容器）
#
# 表的归属：默认仍由应用启动时 create_all（最省事，升级即用）。
# 要交给 Alembic 管（推荐用于正式环境，schema 有版本可追溯），按顺序做两步：
#   1) 先建表：docker compose exec app alembic upgrade head
#   2) 再把下面这行改成 false 并重启
# 置成 false 之后，若库里没有 users 表，启动会**直接报错**并提示该命令——
# 这是有意的：让应用偷偷补表会让迁移历史与真实 schema 分叉，很难查。
DSZOON_AUTO_CREATE_SCHEMA=true

# 定时调度：多实例部署时只让一个实例开（否则同一个策略会被执行多次）
DSZOON_SCHEDULER_ENABLED=true
DSZOON_SCHEDULER_POLL_SECONDS=30

# 保留策略自动清理间隔（小时）。0 = 只允许在界面上手工点"立即清理"。
# 别轻易设 0：只靠人点的清理在真实环境里等于永远不跑，版本会堆到磁盘满。
DSZOON_RETENTION_INTERVAL_HOURS=24

# ---- P3 ----
# 采集到新版本后自动跑合规基线。关掉就只能手工点"立即检查"。
DSZOON_COMPLIANCE_ENABLED=true
# 自定义合规规则文件（JSON 数组；留空/不写 = 用内置基线）。
# 给了就**整体替换**内置规则，不是叠加。
# DSZOON_COMPLIANCE_RULES='["/etc/dszoon/rules.yaml"]'

# ---- P4：配置下发（默认关闭，这是刻意的）----
# P0~P3 只读设备，最坏是"没采到"；P4 往生产设备写配置，最坏是**把网络改坏**。
# 所以"装上就具备下发能力"不是可接受的默认值：开启它应当是一次有记录的人为决定。
# 开启前先读 DEVELOPMENT_PLAN.md §8.5.1 的五条约束。
DSZOON_DEPLOY_ENABLED=false

# 是否允许申请人审批自己的变更单。默认 false = 必须第二人审批。
# 打开意味着"谁申请谁批准"，事后追责链断掉一半，只在单人值守环境考虑。
DSZOON_DEPLOY_ALLOW_SELF_APPROVAL=false

# ---- P4：正文存储后端 ----
# filesystem（默认）| git
# git = 在内容寻址目录之外，把每个**新对象**提交进一个仓库，让"这份配置哪来的、
# 什么时候进来的"有一份独立于本系统数据库的证据（git log）。写错的值会直接报错。
DSZOON_BLOB_BACKEND=filesystem
# git 后端的仓库路径。**对象目录必须在这个仓库内**（默认数据目录下的 objects/，
# 所以仓库根设成 /data 就满足）。不满足时启动会直接报错，不会静默降级。
# DSZOON_GIT_REPO=/data
